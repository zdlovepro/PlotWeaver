  "draft": {
    "scene_id": "ErGen/work-001/0001:chunk-01:scene-001",
    "paragraphs": [
      {
        "paragraph_id": "ErGen/work-001/0001:chunk-01:scene-001:paragraph-00",
        "text": "铁柱的大名叫做王林，他是王天水的儿子。此刻他坐在自家院子的树荫下，手里摆弄着一块平滑的扁石头，眼神却飘向村外那看不到的远方。他的父亲王天水从屋里走出，站到他身后，沉默地看着他的背影。",
        "claimed_fact_ids": [
          "ErGen/work-001/0001:chunk-01:fact-001",
          "ErGen/work-001/0001:chunk-01:fact-002"
        ],
        "claimed_event_ids": []
      },
      {
        "paragraph_id": "ErGen/work-001/0001:chunk-01:scene-001:paragraph-01",
        "text": "铁柱的母亲端着一碗水走出里屋，放在院中的小桌上，又转身回去拿另一碗。这时院门口传来脚步声，四叔走了进来，笑道：“都在啊。”铁柱抬起头看向四叔——父亲的亲弟弟，就住在隔壁——又看了看母亲额头上的汗珠。",
        "claimed_fact_ids": [
          "ErGen/work-001/0001:chunk-01:fact-003",
          "ErGen/work-001/0001:chunk-01:fact-011"
        ],
        "claimed_event_ids": []
      },
      {
        "paragraph_id": "ErGen/work-001/0001:chunk-01:scene-001:paragraph-02",
        "text": "四叔迈进院子，对王天水说：“大哥，恒岳派今年有推荐名额，我想让铁柱去。”王天水看了看铁柱，缓缓点头：“行，那就让他试试。”母亲从屋里探出头，擦着手说：“能去仙门是好事，铁柱这孩子聪明。”四叔笑道：“不过名额有限，王卓那小子听说也想去，他父亲还在走动关系。”王天水沉声道：“既然定了铁柱，就不让。”",
        "claimed_fact_ids": [
          "ErGen/work-001/0001:chunk-01:fact-006"
        ],
        "claimed_event_ids": [
          "ErGen/work-001/0001:chunk-01:event-001"
        ]
      },
      {
        "paragraph_id": "ErGen/work-001/0001:chunk-01:scene-001:paragraph-03",
        "text": "铁柱听着四叔的描述，心中对那神秘的仙人世界生出了浓浓的好奇。",
        "claimed_fact_ids": [
          "ErGen/work-001/0001:chunk-01:fact-004"
        ],
        "claimed_event_ids": []
      },
      {
        "paragraph_id": "ErGen/work-001/0001:chunk-01:scene-001:paragraph-04",
        "text": "铁柱抬头看向父亲，发现父亲眼里藏着很少流露的期待，那目光沉甸甸地压在他心上。他下意识地攥紧手里的石头，脑海里闪过王卓那张总是带着轻蔑的脸。",
        "claimed_fact_ids": [
          "ErGen/work-001/0001:chunk-01:fact-007",
          "ErGen/work-001/0001:chunk-01:fact-008"
        ],
        "claimed_event_ids": []
      },
      {
        "paragraph_id": "ErGen/work-001/0001:chunk-01:scene-001:paragraph-05",
        "text": "片刻后，四叔从怀中掏出两本泛黄的书册，塞到铁柱手中。",
        "claimed_fact_ids": [
          "ErGen/work-001/0001:chunk-01:fact-005"
        ],
        "claimed_event_ids": []
      }
    ]
  },
